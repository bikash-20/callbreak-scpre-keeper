{
  "name": "callbreak-scorekeeper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first Callbreak scorekeeping PWA for four players.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
